<?xml version="1.0" encoding="UTF-8"?>
<!--
================================================================
SITEMAP | MTI - Portfólio de Programador
================================================================
Site:        https://maysonprogrammer.com/
Autor:       MTI (programador em formação)
Idioma:      Português do Brasil (pt-BR)
Tipo:        Landing page de página única (single page)
Tecnologias: HTML5, CSS3, JavaScript, EmailJS, Google reCAPTCHA v2
Atualizado:  2026-10-07

OBJETIVO DO SITE
Apresentar o programador, seus conhecimentos, serviços e projetos,
e oferecer formas de contato para conversas e novas oportunidades.

ESTRUTURA DA PÁGINA (seções internas, acessadas por âncora)
O site é uma única página (index.html). As seções abaixo são
âncoras (#) e NÃO são páginas separadas. Os buscadores ignoram
o que vem depois do "#", por isso elas aparecem aqui apenas como
documentação e não como URLs do sitemap.

  #home      Home: foto de perfil em formato de círculo e
             apresentação ("Olá, eu sou a MTI") com o lema
             "Transformando ideias em código."
  #sobre     Sobre mim: trajetória na programação, interesse em
             tecnologia e desenvolvimento de sistemas, e
             aprendizado contínuo.
  #servicos  O que eu faço: desenvolvimento de aplicações e
             sistemas, criação de páginas web (HTML, CSS),
             lógica de programação e estruturas de dados,
             e conhecimento em hardware e software.
  #projetos  Meus Projetos: link para o GitHub com os projetos
             desenvolvidos.
  #contato   Vamos conversar?: links de Instagram, LinkedIn e
             WhatsApp, mais formulário de contato (nome, e-mail
             e mensagem) com envio por EmailJS e proteção
             reCAPTCHA.

RECURSOS DA PÁGINA
  - Título "MTI" com animação de pulso e brilho (desativada
    para quem prefere menos movimento)
  - Foto de perfil circular ao lado da seção Home (em telas
    menores, fica acima dela)
  - Menu fixo no topo com rolagem suave
  - Menu sanduíche com as opções Home, Sobre, Serviços,
    Projetos e Contatos
  - Botão "Trocar cor" (tema escuro/claro, salvo no navegador)
  - Formulário de contato com reCAPTCHA
  - Layout responsivo: celular em pé, celular na horizontal
    e computador, com suporte a telas com entalhe (notch)

ARQUIVOS DO PROJETO
  index.html   estrutura e conteúdo
  style.css    estilos, temas, animação e responsividade
  main.js      menu sanduíche, troca de tema e envio do formulário
  foto.png     foto de perfil exibida na seção Home
  sitemap.xml  este arquivo
  robots.txt   regras para buscadores, aponta para este sitemap
  readme.md    documentação do projeto

LEGENDA DAS TAGS
  loc         endereço completo da página
  lastmod     data da última alteração (AAAA-MM-DD)
  changefreq  frequência estimada de mudança do conteúdo
  priority    importância relativa, de 0.0 a 1.0
================================================================
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

    <!-- Página principal: contém todas as seções do portfólio
         (Home, Sobre, Serviços, Projetos e Contato). -->
    <url>
        <loc>https://maysonprogrammer.com/</loc>
        <lastmod>2026-10-07</lastmod>
        <changefreq>monthly</changefreq>
        <priority>1.0</priority>
    </url>

    <!-- Se no futuro o site ganhar páginas separadas, adicione um
